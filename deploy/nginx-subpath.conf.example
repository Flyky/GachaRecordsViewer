# Merge these locations into your existing HTTPS server block.
# In data/config.toml set server.public_url = "https://xxx.com/gacha/".
location = /gacha {
    return 308 /gacha/$is_args$args;
}

location /gacha/ {
    # No trailing slash here: preserve /gacha/ when forwarding to Node.
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    client_max_body_size 55m;
    proxy_read_timeout 180s;
}
