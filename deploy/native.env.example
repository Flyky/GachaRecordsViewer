# systemd EnvironmentFile; this is read by systemd, not by the Node application.
NODE_ENV=production
GRV_DATA_DIR=/var/lib/gacha-viewer
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://127.0.0.1:3000
USER_TIMEZONE=Asia/Shanghai
DATABASE_DRIVER=sqlite
# For PostgreSQL, set DATABASE_DRIVER=postgres and uncomment a complete URL:
# DATABASE_URL=postgresql://gacha_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/gacha_records
