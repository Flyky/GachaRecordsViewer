# Copy to .env.postgres and set a password before first startup. Empty values refuse startup.
# Use a random URL-safe password (letters, digits, - or _), since it is also used in DATABASE_URL.
POSTGRES_PASSWORD=
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
PUBLIC_URL=http://127.0.0.1:3000
USER_TIMEZONE=Asia/Shanghai
