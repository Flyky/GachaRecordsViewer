{
  "name": "@gacha/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../../packages/contracts/dist/** --include ../../packages/gacha-core/dist/** --include ../../packages/providers/dist/** --include ../../packages/uigf/dist/** --include ../../packages/db/dist/** src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js --serve-web",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.7",
    "@gacha/contracts": "workspace:*",
    "@gacha/db": "workspace:*",
    "@gacha/gacha-core": "workspace:*",
    "@gacha/providers": "workspace:*",
    "@gacha/uigf": "workspace:*",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
