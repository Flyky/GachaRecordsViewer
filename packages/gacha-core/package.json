{
  "name": "@gacha/gacha-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "update:metadata": "node scripts/update-metadata.mjs",
    "update:banners": "node scripts/update-banners.mjs"
  },
  "devDependencies": { "genshin-db": "5.2.14" }
}
